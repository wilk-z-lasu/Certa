#!/usr/bin/env python3
"""Export the canonical topic IDs for tools that consume a line-based list."""
from pathlib import Path

from voxnews.topic_rules import TOPICS
from voxnews.verify import write_atomic


if __name__ == "__main__":
    write_atomic(Path(__file__).resolve().parent / "user_data" / "all_categories", "\n".join(TOPICS) + "\n")
