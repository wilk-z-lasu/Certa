# Optional settings for the normal app. Store locally in .env.
# Choose ollama for installed local models, or openai for hosted models.
CERTA_PROVIDER=openai
# Leave the OpenAI key empty for key-free text briefings from a prepared catalogue.
# Set to 0 to enable paid OpenAI and ElevenLabs requests for the normal app.
# This setting allows local Ollama inference even while paid requests are paused.
CERTA_API_REQUESTS_PAUSED=1
OPENAI_API_KEY=
# CERTA_GROUPING_MODEL=
# CERTA_EXTRACTION_MODEL=
# CERTA_REVIEW_MODEL=
# CERTA_COMPOSITION_MODEL=
# CERTA_EMBEDDING_MODEL=text-embedding-3-small
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# auto uses an installed speech voice when cloud credentials are absent or requests are paused.
CERTA_NARRATION=auto
