# Copy to .env or export these settings in the shell.
# Choose ollama for installed local models, or openai for hosted models.
VOXNEWS_PROVIDER=openai
# Set to 1 for the isolated cloud demo. Also use app.py --cloud-only.
VOXNEWS_CLOUD_ONLY=1
# Set to 1 to prohibit further paid requests while retaining cached cloud data.
VOXNEWS_API_REQUESTS_PAUSED=1
OPENAI_API_KEY=
# VOXNEWS_GROUPING_MODEL=
# VOXNEWS_EXTRACTION_MODEL=
# VOXNEWS_REVIEW_MODEL=
# VOXNEWS_COMPOSITION_MODEL=
# VOXNEWS_EMBEDDING_MODEL=text-embedding-3-small
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
